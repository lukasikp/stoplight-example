{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/customer.v1.json",
  "title": "Customer",
  "type": "object",
  "required": ["id", "email"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "name": {
      "type": "string"
    },
    "tier": {
      "$ref": "#/$defs/CustomerTier"
    }
  },
  "$defs": {
    "CustomerTier": {
      "type": "string",
      "enum": ["free", "pro", "enterprise"]
    }
  }
}
